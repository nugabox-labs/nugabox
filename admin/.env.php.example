<?php /*
# ============================================================
# NUGABOX 관리자 설정
#
#   cp admin/.env.php.example admin/.env.php
#
# 내용은 평범한 .env 문법입니다. 다만 첫 줄의 `<?php /*` 와 맨 끝의
# 닫는 주석이 이 파일을 PHP 파일로 만들어 줍니다. 덕분에 주소창에서
# /admin/.env.php 를 직접 열어도 웹서버가 PHP 로 실행해 빈 화면만 나오고,
# 안의 내용은 절대 노출되지 않습니다. (nginx 설정을 못 바꾸는 DSM 대응)
#
# 두 줄(맨 위 <?php /* 와 맨 아래 닫는 주석)은 지우지 마세요.
# 값 안에 별표+슬래시 조합은 쓰지 마세요. 주석이 거기서 닫혀 버립니다.
#
# .env.php 는 .gitignore 로 제외되어 커밋되지 않고,
# 배포 시 git reset --hard 에도 지워지지 않습니다.
# ============================================================

# ── 로그인 ──────────────────────────────────────────────────
ADMIN_ID=admin

# 비밀번호는 아래 둘 중 하나만 채우면 됩니다.
#  1) ADMIN_PASSWORD — 평문. 간단합니다.
ADMIN_PASSWORD=바꿀비밀번호

#  2) ADMIN_PASSWORD_HASH — 해시. 둘 다 있으면 이쪽이 우선합니다.
#     php -r "echo password_hash('바꿀비밀번호', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=

# 세션 · 로그인 시도 제한
SESSION_IDLE_HOURS=4
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# ── 업로드 ──────────────────────────────────────────────────
PUBLIC_BASE_URL=https://nugabox.com
UPLOAD_URL_PATH=/upload

# 파일당 최대 크기(MB). php.ini 의 upload_max_filesize · post_max_size 도
# 함께 올려야 실제로 적용됩니다. (DSM: 웹 스테이션 > PHP 프로필)
MAX_UPLOAD_MB=100

# 허용 확장자 (쉼표 구분). 비워 두면 config.php 의 기본 목록을 씁니다.
# svg 는 같은 오리진에서 스크립트가 실행될 수 있어 기본 목록에서 빠져 있습니다.
ALLOWED_EXT=

# ── git 동기화 ──────────────────────────────────────────────
GIT_ENABLED=true
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_COMMIT_MESSAGE=upload 파일 업로드
GIT_AUTHOR_NAME=nugabox admin
GIT_AUTHOR_EMAIL=admin@nugabox.com

# PHP-FPM 사용자의 HOME 이 비어 credential helper 를 못 찾을 때 지정합니다.
# push 만 실패한다면 여기부터 확인하세요.
GIT_HOME=

# ── 기타 ────────────────────────────────────────────────────
# 잠금·로그인 시도 기록을 둘 폴더. 비우면 시스템 임시 폴더(/tmp)를 씁니다.
# 저장소 안에 두지 않으므로 admin/ 에 쓰기 권한을 줄 필요가 없습니다.
RUNTIME_DIR=

*/
