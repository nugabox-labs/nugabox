<?php /*
# ============================================================
# NUGABOX 관리자 설정
#
#   cp admin/.env.php.example admin/.env.php
#
# 내용은 평범한 .env 문법입니다. 다만 첫 줄의 `<?php /*` 와 맨 끝의
# 닫는 주석이 이 파일을 PHP 파일로 만들어 줍니다. 덕분에 주소창에서
# /admin/.env.php 를 직접 열어도 웹서버가 PHP 로 실행해 빈 화면만 나오고,
# 안의 내용은 노출되지 않습니다. (nginx 설정을 못 바꾸는 DSM 대응)
#
# 두 줄(맨 위 <?php /* 와 맨 아래 닫는 주석)은 지우지 마세요.
# 값 안에 별표+슬래시 조합은 쓰지 마세요. 주석이 거기서 닫혀 버립니다.
#
# .env.php 는 .gitignore 로 제외되어 커밋되지 않고,
# 배포 시 git reset --hard 에도 지워지지 않습니다.
# ============================================================

# ── 로그인 ──────────────────────────────────────────────────
# 비밀번호만 입력해서 들어갑니다. 아이디는 없습니다.
# 아래 둘 다 비어 있으면 관리자는 503 으로 완전히 막힙니다.

#  1) ADMIN_PASSWORD — 평문. 간단합니다.
ADMIN_PASSWORD=바꿀비밀번호

#  2) ADMIN_PASSWORD_HASH — 해시. 둘 다 있으면 이쪽이 우선합니다.
#     php -r "echo password_hash('바꿀비밀번호', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=

# 세션 · 로그인 시도 제한
SESSION_IDLE_HOURS=4
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# 잠금 · 로그인 시도 기록을 둘 폴더. 비우면 시스템 임시 폴더를 씁니다.
RUNTIME_DIR=

# ── 아이콘 업로드 ───────────────────────────────────────────
# 파일당 최대 크기(MB). php.ini 의 upload_max_filesize · post_max_size 도
# 함께 올려야 실제로 적용됩니다. (DSM: 웹 스테이션 > PHP 프로필)
MAX_UPLOAD_MB=8

# 허용 확장자 (쉼표 구분). 비우면 png,jpg,jpeg,webp,gif 입니다.
# svg 는 같은 오리진에서 스크립트가 실행될 수 있어 기본 목록에서 빠져 있습니다.
ALLOWED_EXT=

# ── git 동기화 ──────────────────────────────────────────────
# 배포는 `git reset --hard origin/main` 입니다. 즉 관리자에서 바꾼 내용이
# GitHub 까지 올라가지 않으면 다음 배포 때 통째로 사라집니다.
# GIT_ENABLED=false 로 두면 파일만 바뀌고 배포 때 되돌아갑니다.
GIT_ENABLED=true
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_AUTHOR_NAME=nugabox admin
GIT_AUTHOR_EMAIL=admin@nugabox.com
GIT_TIMEOUT_SEC=180

# 저장소 경로. 비우면 이 파일 기준 상위 폴더를 씁니다.
GIT_REPO_DIR=

# PHP-FPM 사용자의 HOME 이 비어 있으면 credential helper 를 못 찾습니다.
# 필요하면 push 가능한 계정의 홈 경로를 지정하세요. (빈 값 = 건드리지 않음)
GIT_HOME=

# ── git push 자격증명 ───────────────────────────────────────
# 웹서버 사용자(시놀로지는 보통 http)는 자기 홈에 GitHub 자격증명이 없어서
# "could not read Username for 'https://github.com'" 으로 push 만 실패합니다.
# 아래 셋 중 하나를 채우면 됩니다.
#
#  1) GIT_TOKEN — GitHub 개인 액세스 토큰. 가장 간단하고 권장합니다.
#     Fine-grained token 이라면 이 저장소에 Contents: Read and write 권한이 필요합니다.
#     토큰은 명령줄에 노출되지 않습니다. 0600 임시 파일로만 전달합니다.
GIT_TOKEN=

#  2) GIT_USERNAME — 비우면 원격 URL 의 사용자명, 그것도 없으면 x-access-token
GIT_USERNAME=

#  3) GIT_CREDENTIALS_FILE — 이미 만들어 둔 git credential store 형식 파일 경로
GIT_CREDENTIALS_FILE=

*/
